<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | DBC Resources</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="https://designbycristina.com{{ page.url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Jost:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<!-- HEADER-START -->
<header id="site-header">
  <nav class="nav">
    <a class="logo" href="https://designbycristina.com/"><img src="/images/dbc-logo-teal.png" alt="Design by Cristina" class="logo-img"></a>
    <button class="navtoggle" id="navtoggle" aria-label="Open menu">&#9776;</button>
    <div class="navlinks" id="navlinks">
      <a href="https://designbycristina.com/">Home</a>
      <a href="https://designbycristina.com/#app">Forms App</a>
      <a href="https://designbycristina.com/#solutions">Solutions</a>
      <a href="https://designbycristina.com/#about">About</a>
      <a href="https://designbycristina.com/pricing.html">Pricing</a>
      <a href="/resources/">Resources</a>
      <a href="https://designbycristina.com/#contact">Contact</a>
    </div>
  </nav>
</header>
<!-- HEADER-END -->
  <main>
    <div class="wrap">
      {{ content | safe }}
    </div>
  </main>
<!-- FOOTER-START -->
<footer>
  <div class="wrap">
    <a class="logo" href="https://designbycristina.com/"><img src="/images/dbc-logo-white.png" alt="Design by Cristina" class="logo-img"></a>
    <div class="footlinks">
      <a href="https://designbycristina.com/#app">Forms App</a>
      <a href="https://designbycristina.com/#solutions">Solutions</a>
      <a href="https://designbycristina.com/#services">Services</a>
      <a href="https://designbycristina.com/pricing.html">Pricing</a>
      <a href="https://designbycristina.com/portfolio.html">Portfolio</a>
      <a href="/resources/">Resources</a>
      <a href="https://designbycristina.com/#contact">Contact</a>
    </div>
    <small>&copy; 2026 Design by Cristina. All rights reserved.</small>
  </div>
</footer>
<!-- FOOTER-END -->
<!-- SCRIPT-START -->
<script>
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    header.classList.toggle('scrolled', window.scrollY > 8);
  });
  const navtoggle = document.getElementById('navtoggle');
  const navlinks = document.getElementById('navlinks');
  navtoggle.addEventListener('click', () => navlinks.classList.toggle('open'));
  navlinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => navlinks.classList.remove('open')));
</script>
<!-- SCRIPT-END -->
</body>
</html>
